rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/professionals/$(request.auth.uid)); }
    function activeProfessional() {
      return signedIn() && profile().data.active == true && profile().data.organizationId == 'sive';
    }
    function administrator() { return activeProfessional() && profile().data.role == 'admin'; }

    // Las cuentas se crean en Firebase Authentication y un administrador crea
    // después su perfil profesional. Así nadie obtiene acceso solo por registrarse.
    match /professionals/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || administrator());
      allow list, create, update, delete: if administrator();
    }

    match /brigades/{brigadeId} {
      allow get, list: if (resource.data.organizationId == 'sive'
        && resource.data.status == 'Activa') || activeProfessional();
      allow create: if administrator()
        && request.resource.data.organizationId == 'sive';
      allow update, delete: if administrator()
        && resource.data.organizationId == 'sive'
        && request.resource.data.organizationId == 'sive';
    }

    match /brigadeRegistrations/{registrationId} {
      allow read: if activeProfessional();
      allow create: if request.resource.data.organizationId == 'sive'
        && request.resource.data.brigadeId is string
        && request.resource.data.participantName is string
        && request.resource.data.profession is string;
      allow update, delete: if administrator();
    }

    match /clinicalRecords/{recordId} {
      allow read: if activeProfessional();
      allow create: if activeProfessional()
        && request.resource.data.organizationId == 'sive'
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if activeProfessional()
        && resource.data.organizationId == 'sive'
        && request.resource.data.organizationId == 'sive'
        && request.resource.data.createdBy == resource.data.createdBy
        && (request.auth.uid == resource.data.createdBy || administrator());
      allow delete: if administrator();
    }

    match /triageRecords/{recordId} {
      allow read: if activeProfessional();
      allow create: if activeProfessional()
        && request.resource.data.organizationId == 'sive'
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if activeProfessional()
        && resource.data.organizationId == 'sive'
        && request.resource.data.organizationId == 'sive'
        && request.resource.data.createdBy == resource.data.createdBy
        && (request.auth.uid == resource.data.createdBy || administrator());
      allow delete: if administrator();
    }

    match /psychologyRecords/{recordId} {
      allow read: if activeProfessional();
      allow create: if activeProfessional()
        && request.resource.data.organizationId == 'sive'
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if activeProfessional()
        && resource.data.organizationId == 'sive'
        && request.resource.data.organizationId == 'sive'
        && request.resource.data.createdBy == resource.data.createdBy
        && (request.auth.uid == resource.data.createdBy || administrator());
      allow delete: if administrator();
    }
  }
}
